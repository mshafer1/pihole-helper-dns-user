# region: pihole settings, place in _env_pihole file.
# Optional
# The password for pihole to use for the web interface.
# If not set, the sidecar will generate a random password and store it in the _env_pihole file.
FTLCONF_webserver_api_password='your_pihole_web_password_here' # the password for the pihole web interface. This is optional.

# region: sidecar settings, place in _env_sidecar file.
# usingThe IP and port pihole is accessible on from the sidecar container.
# If using pihole on another machine, uncomment and set the correct IP and port.
# PIHOLE_HOST='172.17.0.2:80'

# This is the password used to access the dashboard. It should be a strong password.
APP_PASSWORD='create a strong password here'

# This is used for session management and should be a long random string
# consider the output from:
# python3 -c "import secrets, string; alphabet = string.ascii_letters + string.digits; print(''.join(secrets.choice(alphabet) for _ in range(64)))"
SECRET_KEY='your secret key here'

# This is the port that the user will use to load this dashboard.
SIDECAR_PORT=80
